{
  "name": "kirlet-hr",
  "version": "0.4.1",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "bun run src/server.ts",
    "dev": "bun --watch run src/server.ts",
    "test": "KIRLET_AUTH=off bun test --max-concurrency 1",
    "release": "standard-version --config .versionrc.cjs",
    "release:dry": "standard-version --config .versionrc.cjs --dry-run",
    "release:first": "standard-version --config .versionrc.cjs --first-release",
    "docker:build": "docker build --build-context kit=../kirel-nox/libs/kit -t kyostenas/kirlet-hr:$(cat VERSION) -t kyostenas/kirlet-hr:latest ."
  },
  "dependencies": {
    "@opus-perpetuus/kirel-nox-kit": "file:../kirel-nox/libs/kit"
  },
  "devDependencies": {
    "@types/bun": "^1.2.8",
    "standard-version": "^9.5.0"
  }
}
